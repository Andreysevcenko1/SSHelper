TELEGRAM_BOT_TOKEN=
DATABASE_URL=sqlite:///./sshelper.db
POLL_INTERVAL_SECONDS=120

# ── Broadcast / Forum-topic delivery (optional) ──────────────────────────────
# Set BROADCAST_ENABLED=true to enable group/forum-topic delivery in addition
# to personal DM notifications. When enabled, all THREAD_* ids and
# BROADCAST_CHAT_ID must also be set.
BROADCAST_ENABLED=false
BROADCAST_CHAT_ID=
THREAD_IRE_RIGA=
THREAD_SELL_RIGA=
THREAD_AUTO_RIGA=
THREAD_OTHER_CITIES=
# Optional extra topic threads:
THREAD_WORK_RIGA=
THREAD_FLEA_MARKET=

# ── Group watcher (optional) ──────────────────────────────────────────────────
# Polling interval for the independent group search pipeline.
# Defaults to POLL_INTERVAL_SECONDS if not set.
GROUP_POLL_INTERVAL_SECONDS=

# ── Admin users (optional) ────────────────────────────────────────────────────
# Comma-separated list of Telegram user IDs allowed to use /gadd, /glist, etc.
ADMIN_USER_IDS=

# ── Facebook Page auto-posting (optional) ─────────────────────────────────────
# Auto-posts group-watcher listings to Facebook Pages via the Graph API,
# in addition to Telegram. Facebook does NOT support bot posting into regular
# Groups — Pages + Page access tokens are the only supported targets.
#
# Simple mode: one Page for all listings.
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
#
# Concrete "topics" mode: route different categories to different Pages.
# If a route target exists, it overrides FACEBOOK_PAGE_ID for that route.
# Supported route keys: ire_riga, sell_riga, auto_riga, work_riga,
# flea_market, other.
# Example:
# FACEBOOK_ROUTE_TARGETS_JSON={"ire_riga":{"page_id":"111","access_token":"EAAB..."},"auto_riga":{"page_id":"222","access_token":"EAAB..."}}
FACEBOOK_ROUTE_TARGETS_JSON=
